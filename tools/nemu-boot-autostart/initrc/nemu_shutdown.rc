# KernelSU module initrc: runs before init performs the actual reboot/poweroff.
# Works for every normal shutdown source (power key, system UI, apps using
# PowerManager) because all of them set sys.powerctl and init queues `shutdown`.
on shutdown
    exec u:r:su:s0 root root -- /system/bin/sh /data/adb/modules/nemu_boot_autostart/restore_if_frozen.sh
